<Window x:Class="DualSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/LOGO.png"
        Title="DualSync - Dual Audio Sync Suite"
        Width="1185"
        Height="690"
        MinWidth="980"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#EFF6FF"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Brand50" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Brand100" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="Brand600" Color="#2563EB"/>
        <SolidColorBrush x:Key="Brand700" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSlate700" Color="#334155"/>
        <SolidColorBrush x:Key="TextSlate500" Color="#64748B"/>
        <SolidColorBrush x:Key="TextSlate400" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderLight" Color="#E2E8F0"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="14" ShadowDepth="2" Color="#0F172A" Opacity="0.05"/>
        <DropShadowEffect x:Key="FloatingBarShadow" BlurRadius="24" ShadowDepth="4" Color="#0F172A" Opacity="0.08"/>

        <StreamGeometry x:Key="AudioIconGeometry">M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z</StreamGeometry>
        <StreamGeometry x:Key="DevicesIconGeometry">M12 3c-4.97 0-9 4.03-9 9v7c0 1.1.9 2 2 2h4v-8H5v-1c0-3.87 3.13-7 7-7s7 3.13 7 7v1h-4v8h4c1.1 0 2-.9 2-2v-7c0-4.97-4.03-9-9-9z</StreamGeometry>
        <StreamGeometry x:Key="AnalyticsIconGeometry">M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z</StreamGeometry>
        <StreamGeometry x:Key="ReportIconGeometry">M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z</StreamGeometry>
        <StreamGeometry x:Key="LaptopIconGeometry">M20 18c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z</StreamGeometry>
        <StreamGeometry x:Key="ShieldIconGeometry">M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z</StreamGeometry>
        <StreamGeometry x:Key="WarningIconGeometry">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</StreamGeometry>
        <StreamGeometry x:Key="AlertCircleGeometry">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z</StreamGeometry>
        <StreamGeometry x:Key="GearIconGeometry">M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z</StreamGeometry>
        <StreamGeometry x:Key="PulseIconGeometry">M3 13h3l2.5-9 4.5 16 3.5-10 2 3h2.5</StreamGeometry>
        <StreamGeometry x:Key="TimerIconGeometry">M15 1H9v2h6V1zm-4 13h2V8h-2v6zm8.03-6.61l1.42-1.42c-.43-.51-.9-.99-1.41-1.41l-1.42 1.42C16.07 4.74 14.12 4 12 4c-4.97 0-9 4.03-9 9s4.02 9 9 9 9-4.03 9-9c0-2.12-.74-4.07-1.97-5.61zM12 20c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z</StreamGeometry>
        <StreamGeometry x:Key="PrinterIconGeometry">M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z</StreamGeometry>
        <StreamGeometry x:Key="TableIconGeometry">M3 3v18h18V3H3zm8 16H5v-6h6v6zm0-8H5V5h6v6zm8 8h-6v-6h6v6zm0-8h-6V5h6v6z</StreamGeometry>

        <Style x:Key="SideNavTabStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="66"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" CornerRadius="14" Background="Transparent" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="Brd" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Brd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryPillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" CornerRadius="19" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PillBorder" Property="Background" Value="#94A3B8"/>
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinVolumeSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track" Margin="6,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="#2563EB" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="{TemplateBinding Background}" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="16" Height="16" CornerRadius="8" Background="White" BorderBrush="#2563EB" BorderThickness="2.5">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000" Opacity="0.15"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="#E2E8F0" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="#E2E8F0" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                            <Grid x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>

        <Style x:Key="CleanDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid Margin="0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="22" Background="White" BorderBrush="#DBEAFE" BorderThickness="1.5" HorizontalAlignment="Center" ToolTip="DualSync Audio Hub" Padding="3">
                        <Image Source="/Assets/LOGO.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="DualSync" FontSize="10" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <RadioButton x:Name="NavConsoleRadio" Style="{StaticResource SideNavTabStyle}" IsChecked="True" 
                                 GroupName="SideNav" ToolTip="Audio Console &amp; Sync Control" Checked="NavConsoleRadio_Checked">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Width="18" Height="18" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource AudioIconGeometry}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Audio" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavNodesRadio" Style="{StaticResource SideNavTabStyle}" 
                                 GroupName="SideNav" ToolTip="Audio Output Devices" Checked="NavNodesRadio_Checked">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Width="18" Height="18" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource DevicesIconGeometry}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Devices" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavReportsRadio" Style="{StaticResource SideNavTabStyle}" 
                                 GroupName="SideNav" ToolTip="Stream Activity &amp; Oscilloscope" Checked="NavReportsRadio_Checked">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Width="18" Height="18" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource AnalyticsIconGeometry}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Analytics" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavExportRadio" Style="{StaticResource SideNavTabStyle}" 
                                 GroupName="SideNav" ToolTip="Telemetry &amp; Audit Report" Checked="NavExportRadio_Checked">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Width="18" Height="18" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Data="{StaticResource ReportIconGeometry}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Report" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Border Grid.Row="2" Width="44" Height="44" CornerRadius="12" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1.5"
                        HorizontalAlignment="Center" Cursor="Hand">
                    <Border.ToolTip>
                        <ToolTip Background="Transparent" BorderThickness="0" Padding="0">
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="14" Width="260">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Color="#0F172A" Opacity="0.12"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="34" Height="34" CornerRadius="8" Background="#EFF6FF" Margin="0,0,10,0">
                                            <Path Width="16" Height="16" Stretch="Uniform" Fill="#2563EB" Data="{StaticResource LaptopIconGeometry}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="ProfileLaptopNameText" Text="HOST-LAPTOP" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock Text="Windows Host Machine" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Height="1" Background="#F1F5F9" Margin="0,0,0,8"/>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="🔋 Host Power" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock x:Name="ProfileBatteryText" Text="AC Power" FontSize="11" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="🎧 Audio Endpoints" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock x:Name="ProfileDevicesCountText" Text="0 Active" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="⏱️ Configured Delay" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock x:Name="ProfileDelayText" Text="0.0 ms" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </ToolTip>
                    </Border.ToolTip>

                    <Grid>
                        <Path Width="18" Height="18" Stretch="Uniform" Fill="#2563EB" Data="{StaticResource LaptopIconGeometry}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Width="9" Height="9" Fill="#10B981" Stroke="White" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="416*"/>
                <ColumnDefinition Width="85*"/>
                <ColumnDefinition Width="615*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,0" Grid.ColumnSpan="3">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="White" BorderBrush="#DBEAFE" BorderThickness="1" Margin="0,0,10,0" Padding="2">
                            <Image Source="/Assets/LOGO.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="DualSync" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <TextBlock Text="Audio Hub" FontSize="18" FontWeight="ExtraBold" Foreground="#2563EB" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0 DualStream Architecture" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="16" Padding="12,5" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,7,0"/>
                                <TextBlock x:Name="HeaderStatusText" Text="DualStream • Ready" FontSize="11" FontWeight="SemiBold" Foreground="#047857"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="8,4" Cursor="Hand">
                            <Border.ToolTip>
                                <ToolTip Background="Transparent" BorderThickness="0" Padding="0">
                                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="14" Width="260">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Color="#0F172A" Opacity="0.12"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Path Width="16" Height="16" Stretch="Uniform" Fill="#2563EB" Data="{StaticResource LaptopIconGeometry}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TopHoverLaptopName" Text="HOST-LAPTOP" FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Height="1" Background="#F1F5F9" Margin="0,0,0,6"/>
                                            <Grid Margin="0,2">
                                                <TextBlock Text="Host Power:" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="TopBatteryText" Text="AC Power" FontSize="11" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <TextBlock Text="Selected Devices:" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="TopDevicesCountText" Text="0 Active" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#2563EB" Margin="0,0,6,0">
                                    <Path Width="11" Height="11" Stretch="Uniform" Fill="White" Data="{StaticResource LaptopIconGeometry}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TopLaptopNameText" Text="ADITESH" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.ColumnSpan="3">

                <ScrollViewer x:Name="Page1_Console" Visibility="Visible" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
                    <StackPanel Margin="28,20,28,20" HorizontalAlignment="Stretch">

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="22,18" Effect="{StaticResource CardShadow}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="DUAL SYNC CONSOLE" FontSize="10" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,4"/>
