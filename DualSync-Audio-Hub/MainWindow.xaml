                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Reset to Neutral (0 ms)" FontSize="12" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
