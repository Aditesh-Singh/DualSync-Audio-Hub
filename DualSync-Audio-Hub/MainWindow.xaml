                                    <Slider x:Name="Device1VolumeSlider" Style="{StaticResource ThinVolumeSliderStyle}" Minimum="0" Maximum="100" Value="90" ValueChanged="Device1VolumeSlider_ValueChanged"/>

                                    <Border x:Name="Device1SafetyBorder" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,6,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="Device1SafetyDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Device1SafetyTitle" Text="● Safe Volume" FontSize="11" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="1" Height="12" Background="#A7F3D0" Margin="12,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Device1SafetyValue" Grid.Column="2" Text="32% / 80%" FontSize="11" FontWeight="Bold" Foreground="#047857" VerticalAlignment="Center"/>
                                            <Border Grid.Column="3" Width="1" Height="12" Background="#A7F3D0" Margin="12,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Path x:Name="Device1SafetyIcon" Width="12" Height="12" Stretch="Uniform" Fill="#047857" Data="{StaticResource ShieldIconGeometry}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Device1SafetyDetail" Text="Within safe listening limit" FontSize="11" Foreground="#047857" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,2,0,0">
                                        <Button x:Name="Device1ChimeButton" Content="🔔 Test Chime" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Left" Click="Device1ChimeButton_Click"/>
                                        <Button x:Name="Device1MuteButton" Content="🔊 Mute" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Right" Click="Device1MuteButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Earbuds 2 (Beta)" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse x:Name="Device2StatusDot" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Device2StatusText" Text="Not connected" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border CornerRadius="10" BorderBrush="#CBD5E1" BorderThickness="1" Background="White" Margin="0,0,0,14">
                                        <ComboBox x:Name="Device2ComboBox" Height="36" BorderThickness="0" Background="Transparent" 
                                                  Padding="10,0" VerticalContentAlignment="Center" DisplayMemberPath="FriendlyName" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>

                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Volume Gain" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                                        <TextBlock x:Name="Vol2Label" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#D97706"
                                                   Text="{Binding Value, ElementName=Device2VolumeSlider, StringFormat={}{0:0}%}"/>
                                    </Grid>
                                    <Slider x:Name="Device2VolumeSlider" Style="{StaticResource ThinVolumeSliderStyle}" Minimum="0" Maximum="100" Value="85" ValueChanged="Device2VolumeSlider_ValueChanged"/>

                                    <Border x:Name="Device2SafetyBorder" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,6,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse x:Name="Device2SafetyDot" Width="7" Height="7" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Device2SafetyTitle" Text="● Volume Limit Near" FontSize="11" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="1" Height="12" Background="#FDE68A" Margin="12,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Device2SafetyValue" Grid.Column="2" Text="78% / 80%" FontSize="11" FontWeight="Bold" Foreground="#B45309" VerticalAlignment="Center"/>
                                            <Border Grid.Column="3" Width="1" Height="12" Background="#FDE68A" Margin="12,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Path x:Name="Device2SafetyIcon" Width="12" Height="12" Stretch="Uniform" Fill="#B45309" Data="{StaticResource WarningIconGeometry}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Device2SafetyDetail" Text="Approaching safety limit" FontSize="11" Foreground="#B45309" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,2,0,0">
                                        <Button x:Name="Device2ChimeButton" Content="🔔 Test Chime" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Left" Click="Device2ChimeButton_Click"/>
                                        <Button x:Name="Device2MuteButton" Content="🔊 Mute" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Right" Click="Device2MuteButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="18,14" Effect="{StaticResource CardShadow}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="38" Height="38" CornerRadius="10" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" Margin="0,0,12,0">
                                        <Path Width="18" Height="18" Stretch="Uniform" Fill="#2563EB" Data="{StaticResource TimerIconGeometry}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Configured Audio Phase Delay" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                            <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock x:Name="DelayStatusBadge" Text="Neutral (0.0 ms)" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Adjust configured relative buffer timing (-20 ms to +20 ms) between Earbuds 1 and 2. Not a measured acoustic sync result." FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Width="320">
                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="-20 ms" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="DelayLabel" Text="0.0 ms" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                        <TextBlock Text="+20 ms" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Slider x:Name="DelayRangeSlider" Style="{StaticResource ThinVolumeSliderStyle}" Width="320" Minimum="-20" Maximum="20" Value="0" SmallChange="0.5" LargeChange="2.0" ValueChanged="DelayRangeSlider_ValueChanged"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="18,14" Effect="{StaticResource FloatingBarShadow}" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#10B981" Margin="0,0,10,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="StatusText" Text="Running" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                                        <TextBlock x:Name="StatusDetailText" Text="Dual audio streaming active • Both earbuds connected" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="RefreshButton" Content="⟳ Refresh Devices" Style="{StaticResource PillButtonStyle}" Margin="0,0,8,0" Click="RefreshButton_Click"/>
                                    <Button x:Name="StartButton" Content="▶ Start DualSync" Style="{StaticResource PrimaryPillButtonStyle}" Margin="0,0,8,0" Click="StartButton_Click"/>
                                    <Button x:Name="StopButton" Content="■ Stop" Style="{StaticResource PillButtonStyle}" IsEnabled="False" Click="StopButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="Page2_Nodes" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
                    <StackPanel Margin="28,20,28,24" HorizontalAlignment="Stretch">
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="22" Effect="{StaticResource CardShadow}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="My Audio Devices" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="Complete overview of all Windows audio output devices and their DualSync slot assignments." FontSize="12" Foreground="{StaticResource TextSlate500}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,10,0">
                                        <TextBlock x:Name="DevicesCountBadge" Text="0 Devices Found" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A"/>
                                    </Border>
                                    <Button x:Name="ScanBtn" Content="🔄 Scan for Devices" Style="{StaticResource PillButtonStyle}" Click="RefreshButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="18,14" Effect="{StaticResource CardShadow}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock Text="Active Slot Assignments" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,0,0,10"/>
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#F4F8FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#2563EB" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                        <TextBlock Text="Earbuds 1 (Alpha)" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock x:Name="Slot1NameText" Text="No device selected" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock x:Name="Slot1DetailsText" Text="Hardware endpoint query: Standby" FontSize="11" Foreground="{StaticResource TextSlate500}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Button Content="🔊 Test" Style="{StaticResource PillButtonStyle}" Height="28" Padding="10,0" FontSize="11" Margin="0,0,4,0" Click="Device1ChimeButton_Click"/>
                                                <Button x:Name="AssignNode1Btn" Content="Assign Slot 1" Style="{StaticResource PillButtonStyle}" Height="28" Padding="10,0" FontSize="11" Click="AssignNode1Btn_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" Background="#FAF5FF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="12" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#7C3AED" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                                        <TextBlock Text="Earbuds 2 (Beta)" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock x:Name="Slot2NameText" Text="No device selected" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextDark}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock x:Name="Slot2DetailsText" Text="Hardware endpoint query: Standby" FontSize="11" Foreground="{StaticResource TextSlate500}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Button Content="🔊 Test" Style="{StaticResource PillButtonStyle}" Height="28" Padding="10,0" FontSize="11" Margin="0,0,4,0" Click="Device2ChimeButton_Click"/>
                                                <Button x:Name="AssignNode2Btn" Content="Assign Slot 2" Style="{StaticResource PillButtonStyle}" Height="28" Padding="10,0" FontSize="11" Click="AssignNode2Btn_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20" Effect="{StaticResource CardShadow}" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,14" HorizontalAlignment="Stretch">
                                    <TextBlock Text="All Discovered Audio Devices" FontSize="15" FontWeight="ExtraBold" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="Select any endpoint to test or assign directly to Earbuds 1 or Earbuds 2" FontSize="11" Foreground="{StaticResource TextSlate400}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <ItemsControl x:Name="DiscoveredDevicesItemsControl" HorizontalAlignment="Stretch">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                                <Grid HorizontalAlignment="Stretch">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DeviceIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding FriendlyName}" FontSize="13" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding DeviceType}" FontSize="10" FontWeight="SemiBold" Foreground="#1D4ED8"/>
                                                            </Border>
                                                            <TextBlock Text="● Active Endpoint" FontSize="10" Foreground="#059669" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Border Grid.Column="2" Background="{Binding SlotBadgeBackground}" BorderBrush="{Binding SlotBadgeBorder}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SlotAssignment}" FontSize="11" FontWeight="Bold" Foreground="{Binding SlotBadgeForeground}"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="🔔 Test" Style="{StaticResource PillButtonStyle}" Height="30" Padding="10,0" FontSize="11" Margin="0,0,6,0" Click="DeviceCardChime_Click" ToolTip="Test chime on this specific endpoint"/>
                                                        <Button Content="Set Earbuds 1" Style="{StaticResource PillButtonStyle}" Height="30" Padding="12,0" FontSize="11" Margin="0,0,6,0" Click="DeviceCardAssignSlot1_Click"/>
                                                        <Button Content="Set Earbuds 2" Style="{StaticResource PillButtonStyle}" Height="30" Padding="12,0" FontSize="11" Click="DeviceCardAssignSlot2_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="Page3_Reports" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
                    <StackPanel Margin="28,20,28,24" HorizontalAlignment="Stretch">
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="22" Effect="{StaticResource CardShadow}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Sound Activity &amp; Diagnostics" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="Review stream runtime, delay offsets, and timestamped event logs." FontSize="12" Foreground="{StaticResource TextSlate500}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBox x:Name="EventFilterComboBox" Width="140" Height="36" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="EventFilterComboBox_SelectionChanged">
                                        <ComboBoxItem Content="All Events"/>
                                        <ComboBoxItem Content="Sync Events"/>
                                        <ComboBoxItem Content="Volume"/>
                                        <ComboBoxItem Content="Connections"/>
                                    </ComboBox>
                                    <Button x:Name="BtnClear" Content="🗑 Clear Logs" Style="{StaticResource PillButtonStyle}" Click="BtnClear_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <UniformGrid Columns="4" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,6,0" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <TextBlock Text="SYNC MODE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSlate400}"/>
                                    <TextBlock x:Name="SyncModeStatusText" Text="Standby" FontSize="16" FontWeight="ExtraBold" Foreground="#64748B" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="SyncModeDetailText" Text="Audio engine idle" FontSize="11" Foreground="{StaticResource TextSlate500}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="3,0,3,0" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE STREAM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSlate400}"/>
                                    <TextBlock x:Name="StreamDurationText" Text="00:00:00" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource TextDark}" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="StreamStatusSubText" Text="Engine stopped" FontSize="11" Foreground="{StaticResource TextSlate500}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="3,0,3,0" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <TextBlock Text="CONFIGURED DELAY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSlate400}"/>
                                    <TextBlock x:Name="MetricDelayDisplay" Text="0.0 ms" FontSize="16" FontWeight="ExtraBold" Foreground="#2563EB" Margin="0,2,0,0"/>
                                    <TextBlock Text="Configured FIFO delay" FontSize="11" Foreground="{StaticResource TextSlate500}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="6,0,0,0" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <TextBlock Text="AUDIO ENDPOINTS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSlate400}"/>
                                    <TextBlock x:Name="ActiveEndpointsSummaryText" Text="0 / 2 Active" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource TextDark}" Margin="0,2,0,0"/>
                                    <TextBlock Text="Hardware playback status" FontSize="11" Foreground="{StaticResource TextSlate500}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Background="#0B132B" CornerRadius="16" Padding="18" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                    <TextBlock Text="Live Stream Waveform &amp; Phase Visualizer" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <CheckBox x:Name="EchoTestCheckBox" Content="Audible Echo Test (+50ms)" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" Click="EchoTestCheckBox_Click" ToolTip="Injects an audible +50ms delay into Output 2 to audibly verify timing offset"/>
                                        <TextBlock Text="Zoom:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="WaveZoomLabel" Text="100%" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" Width="36"/>
                                        <Slider x:Name="WaveZoomSlider" Width="100" Minimum="50" Maximum="200" Value="100" SmallChange="5" LargeChange="25" Style="{StaticResource ThinVolumeSliderStyle}" ValueChanged="WaveZoomSlider_ValueChanged"/>
                                    </StackPanel>
                                </Grid>

                                <Viewbox Height="80" Stretch="Fill" Margin="0,6" HorizontalAlignment="Stretch">
                                    <Canvas x:Name="WaveCanvas" Width="1000" Height="80" ClipToBounds="True">
                                        <Line X1="0" Y1="40" X2="1000" Y2="40" Stroke="#1E293B" StrokeThickness="1" StrokeDashArray="4 4"/>
                                        <Line X1="0" Y1="20" X2="1000" Y2="20" Stroke="#131F37" StrokeThickness="0.75" StrokeDashArray="2 4"/>
                                        <Line X1="0" Y1="60" X2="1000" Y2="60" Stroke="#131F37" StrokeThickness="0.75" StrokeDashArray="2 4"/>

                                        <Path x:Name="Wave1Path" Stroke="#38BDF8" StrokeThickness="2.5"/>
                                        <Path x:Name="Wave2Path" Stroke="#C084FC" StrokeThickness="2"/>
                                    </Canvas>
                                </Viewbox>

                                <Grid Margin="0,4,0,0" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#38BDF8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Alpha (Earbuds 1)" FontSize="11" Foreground="#94A3B8" Margin="0,0,12,0"/>
                                        <Ellipse Width="8" Height="8" Fill="#C084FC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Beta (Earbuds 2)" FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PhaseBadgeText" Text="Configured Delay: 0.0 ms" FontSize="11" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="JitterText" Text="Visual Phase Representation" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="16" Effect="{StaticResource CardShadow}" HorizontalAlignment="Stretch">
                            <TextBox x:Name="SessionLogBox" Height="180" Background="#0F172A" Foreground="#38BDF8"
                                     FontFamily="Consolas" FontSize="11" Padding="10" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" BorderThickness="0" HorizontalAlignment="Stretch"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="Page4_ExportSummary" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
                    <StackPanel Margin="28,20,28,24" HorizontalAlignment="Stretch">

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="22" Effect="{StaticResource CardShadow}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#2563EB" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Path Width="20" Height="20" Stretch="Uniform" Fill="White" Data="{StaticResource ReportIconGeometry}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="System Condition &amp; Telemetry Summary" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="Diagnostic report consolidating active streaming state, device endpoints, audio safety status, and timing offset configuration." 
                                               FontSize="12" Foreground="{StaticResource TextSlate500}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnPrintReport" Style="{StaticResource PrimaryPillButtonStyle}" Click="BtnPrintReport_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="14" Height="14" Stretch="Uniform" Fill="White" Data="{StaticResource PrinterIconGeometry}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Print / Save Report" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="18,16" Effect="{StaticResource CardShadow}" Margin="0,0,10,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#2563EB" Data="{StaticResource GearIconGeometry}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="ENGINE CONDITION" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <Ellipse x:Name="SummaryEngineDot" Width="9" Height="9" Fill="#10B981" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SummaryEngineStateText" Text="Dual Output" FontSize="16" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="WASAPI Loopback Capture" FontSize="11" Foreground="#64748B" Margin="16,0,0,12"/>

                                    <Border x:Name="EngineConditionBox" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="EngineConditionIcon" Grid.Column="0" Width="18" Height="18" Stretch="Uniform" Stroke="#10B981" StrokeThickness="2" Data="{StaticResource PulseIconGeometry}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="EngineConditionTitle" Text="Audio Engine Stable" FontSize="12" FontWeight="Bold" Foreground="#047857"/>
                                                <TextBlock x:Name="EngineConditionDetail" Text="Capturing and streaming normally" FontSize="10" Foreground="#047857" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="18,16" Effect="{StaticResource CardShadow}" Margin="0,0,10,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#2563EB" Data="{StaticResource LaptopIconGeometry}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="DETECTED ENDPOINTS" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="SummaryDeviceCountText" Text="3 Devices" FontSize="18" FontWeight="ExtraBold" Foreground="#2563EB" Margin="0,0,0,2"/>
                                    <TextBlock Text="Discovered Windows Endpoints" FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>

                                    <ScrollViewer MaxHeight="66" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="ReportEndpointsItemsControl">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding DeviceIcon}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding FriendlyName}" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                        <Ellipse Grid.Column="2" Width="6" Height="6" Fill="#10B981" Margin="6,0,2,0" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <TextBlock Text="All audio endpoints enumerated and ready" FontSize="10" Foreground="#64748B" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="18,16" Effect="{StaticResource CardShadow}" Margin="0,0,10,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#2563EB" Data="{StaticResource ShieldIconGeometry}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="HEARING SAFETY" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <Ellipse x:Name="HearingSafetyDot" Width="9" Height="9" Fill="#10B981" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="HearingSafetyStateText" Text="Safe Listening" FontSize="16" FontWeight="ExtraBold" Foreground="#047857" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="HearingSafetySubText" Text="Volume and listening duration within safe limits" FontSize="11" Foreground="#64748B" Margin="16,0,0,10" TextTrimming="CharacterEllipsis"/>

                                    <Grid Margin="0,0,0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="11" Height="11" Stretch="Uniform" Fill="#64748B" Data="{StaticResource AudioIconGeometry}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Current Volume" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HearingSafetyVolText" Text="32% / 80%" FontSize="11" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar x:Name="HearingSafetyVolProgress" Style="{StaticResource RoundedProgressBarStyle}" Value="32" Maximum="100" Foreground="#10B981" Margin="0,2,0,8"/>

                                    <Grid Margin="0,0,0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="11" Height="11" Stretch="Uniform" Fill="#64748B" Data="{StaticResource TimerIconGeometry}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Listening Duration" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HearingSafetyDurationText" Text="00:00:00 / 02:00:00" FontSize="11" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <ProgressBar x:Name="HearingSafetyDurationProgress" Style="{StaticResource RoundedProgressBarStyle}" Value="0" Maximum="100" Foreground="#10B981" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="18,16" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Width="14" Height="14" Stretch="Uniform" Fill="#2563EB" Data="{StaticResource TimerIconGeometry}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="DELAY &amp; SESSION DURATION" FontSize="10" FontWeight="Bold" Foreground="#64748B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock x:Name="SummaryDelayText" Text="0.0 ms" FontSize="18" FontWeight="ExtraBold" Foreground="#2563EB"/>
                                            <TextBlock Text="Configured Offset" FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock x:Name="SummaryDurationText" Text="00:00:37" FontSize="18" FontWeight="ExtraBold" Foreground="#0F172A"/>
                                            <TextBlock Text="Session Runtime" FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Width="18" Height="18" Stretch="Uniform" Fill="#2563EB" Data="{StaticResource AnalyticsIconGeometry}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Synchronization" FontSize="12" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock Text="Circular FIFO buffer delay (-20 ms to +20 ms)" FontSize="9" Foreground="#64748B" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border x:Name="SummarySyncBadge" Grid.Column="2" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="SummarySyncBadgeText" Text="Active" FontSize="10" FontWeight="Bold" Foreground="#047857"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20" Effect="{StaticResource CardShadow}" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,12" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Width="16" Height="16" Stretch="Uniform" Fill="#2563EB" Data="{StaticResource TableIconGeometry}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Consolidated Telemetry Table" FontSize="15" FontWeight="ExtraBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="Real measured parameters &amp; honest OS state" FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <DataGrid x:Name="ConsolidatedTelemetryGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                                          BorderThickness="0" RowBackground="#FAFAFA" AlternatingRowBackground="White"
                                          HorizontalGridLinesBrush="#F1F5F9" FontSize="11" MaxHeight="380" VerticalScrollBarVisibility="Auto" 
                                          ColumnHeaderStyle="{StaticResource CleanDataGridColumnHeaderStyle}"
                                          CellStyle="{StaticResource CleanDataGridCellStyle}"
                                          HorizontalAlignment="Stretch">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="105"/>
                                        <DataGridTextColumn Header="System Source" Binding="{Binding Source}" Width="145"/>
                                        <DataGridTextColumn Header="Metric / Parameter" Binding="{Binding Metric}" Width="180"/>
                                        <DataGridTextColumn Header="Value Readout" Binding="{Binding Value}" Width="220"/>
                                        <DataGridTemplateColumn Header="Quality State" Width="135">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding State}" Foreground="#0F172A" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Audit Notes" Binding="{Binding Notes}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,0" Grid.ColumnSpan="3" Margin="0,662,0,0" Grid.RowSpan="2">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <TextBlock Text="© 2026 DualSync • Dual Earbud Audio Sync Suite" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="FooterStatusText" Text="● Ready • v1.0.0" FontSize="11" FontWeight="SemiBold" Foreground="#047857" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>