<Window x:Class="DualSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/LOGO.png"
        Title="DualSync - Dual Audio Sync Suite"
        Width="1160"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#EFF6FF">

    <Window.Resources>
        <SolidColorBrush x:Key="Brand50" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="Brand100" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="Brand600" Color="#2563EB"/>
        <SolidColorBrush x:Key="Brand700" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="TextDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="TextSlate700" Color="#334155"/>
        <SolidColorBrush x:Key="TextSlate500" Color="#64748B"/>
        <SolidColorBrush x:Key="TextSlate400" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderLight" Color="#DBEAFE"/>

        <DropShadowEffect x:Key="CardShadow" BlurRadius="16" ShadowDepth="2" Color="#1E293B" Opacity="0.05"/>
        <DropShadowEffect x:Key="FloatingBarShadow" BlurRadius="28" ShadowDepth="6" Color="#2563EB" Opacity="0.12"/>

        <Style x:Key="SideNavTabStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" CornerRadius="12" Background="Transparent" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Brd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Brd" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="Brd" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Brd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryPillButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="24,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" CornerRadius="21" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PillBorder" Property="Background" Value="#94A3B8"/>
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinVolumeSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track" Margin="6,0">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="#2563EB" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="{TemplateBinding Background}" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="16" Height="16" CornerRadius="8" Background="White" BorderBrush="#2563EB" BorderThickness="2.5">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000" Opacity="0.15"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="#E2E8F0" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="#E2E8F0" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="76"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SLIM NAVIGATION STRIP (Fixed 76px) -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid Margin="0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Top Brand Logo -->
                <Border Grid.Row="0" Width="46" Height="46" CornerRadius="12" Background="White" BorderBrush="#DBEAFE" BorderThickness="1" HorizontalAlignment="Center" ToolTip="DualSync Audio Hub" Padding="2">
                    <Image Source="/Assets/LOGO.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Navigation Tabs (Center) -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <RadioButton x:Name="NavConsoleRadio" Style="{StaticResource SideNavTabStyle}" IsChecked="True" 
                                 ToolTip="Dual Stream Audio Sync" Margin="0,0,0,16" Checked="NavConsoleRadio_Checked">
                        <TextBlock Text="🔊" FontSize="18"/>
                    </RadioButton>
                    <RadioButton x:Name="NavNodesRadio" Style="{StaticResource SideNavTabStyle}" 
                                 ToolTip="My Audio Devices" Margin="0,0,0,16" Checked="NavNodesRadio_Checked">
                        <TextBlock Text="🎧" FontSize="18"/>
                    </RadioButton>
                    <RadioButton x:Name="NavReportsRadio" Style="{StaticResource SideNavTabStyle}" 
                                 ToolTip="Sound Activity &amp; Diagnostics" Margin="0,0,0,16" Checked="NavReportsRadio_Checked">
                        <TextBlock Text="📈" FontSize="18"/>
                    </RadioButton>
                    <RadioButton x:Name="NavExportRadio" Style="{StaticResource SideNavTabStyle}" 
                                 ToolTip="Export / Report Summary" Checked="NavExportRadio_Checked">
                        <TextBlock Text="📄" FontSize="18"/>
                    </RadioButton>
                </StackPanel>

                <!-- Bottom Laptop Profile with Hover Popover -->
                <Border Grid.Row="2" Width="42" Height="42" CornerRadius="12" Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1.5"
                        HorizontalAlignment="Center" Cursor="Hand">
                    <Border.ToolTip>
                        <ToolTip Background="Transparent" BorderThickness="0" Padding="0">
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="14" Width="260">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Color="#0F172A" Opacity="0.12"/>
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <Border Width="34" Height="34" CornerRadius="8" Background="#EFF6FF" Margin="0,0,10,0">
                                            <TextBlock Text="💻" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="ProfileLaptopNameText" Text="HOST-LAPTOP" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock Text="Windows Host Machine" FontSize="10" Foreground="#64748B"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Height="1" Background="#F1F5F9" Margin="0,0,0,8"/>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="🔋 Host Power" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock x:Name="ProfileBatteryText" Text="AC Power" FontSize="11" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="🎧 Audio Endpoints" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock x:Name="ProfileDevicesCountText" Text="0 Active" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,3">
                                        <TextBlock Text="📶 BT RF Telemetry" FontSize="11" Foreground="#64748B"/>
                                        <TextBlock x:Name="ProfileSignalStrengthText" Text="Unavailable (WASAPI)" FontSize="11" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </ToolTip>
                    </Border.ToolTip>

                    <Grid>
                        <TextBlock Text="💻" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Width="9" Height="9" Fill="#10B981" Stroke="White" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- RIGHT WORKSPACE AREA (Stretches to 100% full width) -->
        <Grid Grid.Column="1" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- Top Header (Stretches to full usable width) -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="24,0" HorizontalAlignment="Stretch">
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="White" BorderBrush="#DBEAFE" BorderThickness="1" Margin="0,0,10,0" Padding="2">
                            <Image Source="/Assets/LOGO.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="DualSync" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                        <TextBlock Text="Audio Hub" FontSize="18" FontWeight="ExtraBold" Foreground="#2563EB" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0 DualStream Architecture" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="16" Padding="12,5" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="#10B981" Margin="0,0,7,0"/>
                                <TextBlock x:Name="HeaderStatusText" Text="DualStream • Ready" FontSize="11" FontWeight="SemiBold" Foreground="#047857"/>
                            </StackPanel>
                        </Border>

                        <!-- TOP RIGHT LAPTOP BADGE -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="8,4" Cursor="Hand">
                            <Border.ToolTip>
                                <ToolTip Background="Transparent" BorderThickness="0" Padding="0">
                                    <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="14" Padding="14" Width="260">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Color="#0F172A" Opacity="0.12"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="💻" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TopHoverLaptopName" Text="HOST-LAPTOP" FontWeight="Bold" FontSize="12" Foreground="#0F172A" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Height="1" Background="#F1F5F9" Margin="0,0,0,6"/>
                                            <Grid Margin="0,2">
                                                <TextBlock Text="Host Power:" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="TopBatteryText" Text="AC Power" FontSize="11" FontWeight="Bold" Foreground="#047857" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,2">
                                                <TextBlock Text="Selected Devices:" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock x:Name="TopDevicesCountText" Text="0 Active" FontSize="11" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </ToolTip>
                            </Border.ToolTip>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="22" Height="22" CornerRadius="11" Background="#2563EB" Margin="0,0,6,0">
                                    <TextBlock Text="💻" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="TopLaptopNameText" Text="LAPTOP" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Multi-Page Viewport (Stretches to full usable width) -->
            <Grid Grid.Row="1" HorizontalAlignment="Stretch">

                <!-- PAGE 1: CONSOLE -->
                <ScrollViewer x:Name="Page1_Console" Visibility="Visible" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
                    <StackPanel Margin="28,20,28,20" HorizontalAlignment="Stretch">
                        
                        <!-- Header Banner (Full Width) -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20,18" Effect="{StaticResource CardShadow}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="DUAL SYNC CONSOLE" FontSize="10" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,0,4"/>
                                    <TextBlock Text="Dual Earbud Audio Sync" FontSize="22" FontWeight="ExtraBold" Foreground="#0F172A"/>
                                    <TextBlock Text="Route captured Windows audio simultaneously to two output devices with real-time delay alignment." FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="QuickCalibrateButton" Grid.Column="1" Content="⚡ Reset to Neutral (0 ms)" Style="{StaticResource PillButtonStyle}" VerticalAlignment="Center" Click="QuickCalibrateButton_Click" ToolTip="Resets manual timing delay to neutral 0.00 ms baseline"/>
                            </Grid>
                        </Border>

                        <!-- Device Slots (Side-by-Side - Stretches equally across available width) -->
                        <Grid Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Earbuds 1 (Alpha) -->
                            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Earbuds 1 (Alpha)" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse x:Name="Device1StatusDot" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Device1StatusText" Text="Not connected" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <ComboBox x:Name="Device1ComboBox" Height="38" DisplayMemberPath="FriendlyName" Margin="0,0,0,14"/>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Volume Gain" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                                        <TextBlock x:Name="Vol1Label" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#2563EB"
                                                   Text="{Binding Value, ElementName=Device1VolumeSlider, StringFormat={}{0:0}%}"/>
                                    </Grid>
                                    <Slider x:Name="Device1VolumeSlider" Style="{StaticResource ThinVolumeSliderStyle}" Minimum="0" Maximum="100" Value="90" ValueChanged="Device1VolumeSlider_ValueChanged"/>
                                    <Grid Margin="0,12,0,0">
                                        <Button x:Name="Device1ChimeButton" Content="🔔 Test Chime" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Left" Click="Device1ChimeButton_Click"/>
                                        <Button x:Name="Device1MuteButton" Content="Mute" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Right" Click="Device1MuteButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Earbuds 2 (Beta) -->
                            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock Text="Earbuds 2 (Beta)" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse x:Name="Device2StatusDot" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="Device2StatusText" Text="Not connected" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <ComboBox x:Name="Device2ComboBox" Height="38" DisplayMemberPath="FriendlyName" Margin="0,0,0,14"/>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Volume Gain" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                                        <TextBlock x:Name="Vol2Label" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#7C3AED"
                                                   Text="{Binding Value, ElementName=Device2VolumeSlider, StringFormat={}{0:0}%}"/>
                                    </Grid>
                                    <Slider x:Name="Device2VolumeSlider" Style="{StaticResource ThinVolumeSliderStyle}" Minimum="0" Maximum="100" Value="85" ValueChanged="Device2VolumeSlider_ValueChanged"/>
                                    <Grid Margin="0,12,0,0">
                                        <Button x:Name="Device2ChimeButton" Content="🔔 Test Chime" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Left" Click="Device2ChimeButton_Click"/>
                                        <Button x:Name="Device2MuteButton" Content="Mute" Style="{StaticResource PillButtonStyle}" HorizontalAlignment="Right" Click="Device2MuteButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Real Audio Phase Delay Alignment Card (Full Width) -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="18,14" Effect="{StaticResource CardShadow}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="⏱️" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Audio Phase Delay Alignment" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                                            <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="6" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock x:Name="DelayStatusBadge" Text="Neutral (0.0 ms)" FontSize="10" FontWeight="Bold" Foreground="#1D4ED8"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Adjust timing difference (-100ms to +100ms) to compensate for mismatched earbud latencies." FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Width="300">
                                    <TextBlock x:Name="DelayLabel" Text="0.0 ms" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,12,0" Width="65" TextAlignment="Right"/>
                                    <Slider x:Name="DelayRangeSlider" Style="{StaticResource ThinVolumeSliderStyle}" Width="220" Minimum="-100" Maximum="100" Value="0" SmallChange="1.0" LargeChange="10.0" ValueChanged="DelayRangeSlider_ValueChanged"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Bottom Control Bar (Full Width) -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="18" Padding="18,14" Effect="{StaticResource FloatingBarShadow}" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#10B981" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="14" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="RefreshButton" Content="⟳ Refresh Devices" Style="{StaticResource PillButtonStyle}" Margin="0,0,8,0" Click="RefreshButton_Click"/>
                                    <Button x:Name="StartButton" Content="▶ Start DualSync" Style="{StaticResource PrimaryPillButtonStyle}" Margin="0,0,8,0" Click="StartButton_Click"/>
                                    <Button x:Name="StopButton" Content="■ Stop" Style="{StaticResource PillButtonStyle}" IsEnabled="False" Click="StopButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PAGE 2: NODES -->
                <ScrollViewer x:Name="Page2_Nodes" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
                    <StackPanel Margin="28,20,28,24" HorizontalAlignment="Stretch">
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="22" Effect="{StaticResource CardShadow}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="My Audio Devices" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="Manage and assign audio endpoints to active DualSync slots." FontSize="12" Foreground="{StaticResource TextSlate500}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,10,0">
                                        <TextBlock x:Name="DevicesCountBadge" Text="0 Devices Found" FontSize="12" FontWeight="Bold" Foreground="#1E3A8A"/>
                                    </Border>
                                    <Button x:Name="ScanBtn" Content="🔄 Scan for Devices" Style="{StaticResource PillButtonStyle}" Click="RefreshButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="22" Effect="{StaticResource CardShadow}" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Stretch">
                                <TextBlock Text="Active Slot Assignments" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource TextDark}" Margin="0,0,0,16"/>

                                <!-- Slot 1 Card -->
                                <Border Background="#F4F8FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="44" Height="44" CornerRadius="12" Background="White" Margin="0,0,12,0">
                                                <TextBlock Text="🎧" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="Slot1NameText" Text="No device selected" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                                <TextBlock x:Name="Slot1DetailsText" Text="Hardware format query: Standby" FontSize="11" Foreground="{StaticResource TextSlate500}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="🔊 Test Chime" Style="{StaticResource PillButtonStyle}" Margin="0,0,8,0" Click="Device1ChimeButton_Click"/>
                                            <Button x:Name="AssignNode1Btn" Content="Set as Earbuds 1" Style="{StaticResource PillButtonStyle}" Click="AssignNode1Btn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Slot 2 Card -->
                                <Border Background="#FAF5FF" BorderBrush="#E9D5FF" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14" HorizontalAlignment="Stretch">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="44" Height="44" CornerRadius="12" Background="White" Margin="0,0,12,0">
                                                <TextBlock Text="🎧" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="Slot2NameText" Text="No device selected" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextDark}"/>
                                                <TextBlock x:Name="Slot2DetailsText" Text="Hardware format query: Standby" FontSize="11" Foreground="{StaticResource TextSlate500}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Content="🔊 Test Chime" Style="{StaticResource PillButtonStyle}" Margin="0,0,8,0" Click="Device2ChimeButton_Click"/>
                                            <Button x:Name="AssignNode2Btn" Content="Set as Earbuds 2" Style="{StaticResource PillButtonStyle}" Click="AssignNode2Btn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="* Note: Windows WASAPI does not expose over-the-air Bluetooth packet loss, RSSI, or earbud internal DSP latency. These values are marked as Unavailable." FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PAGE 3: REPORTS -->
                <ScrollViewer x:Name="Page3_Reports" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
                    <StackPanel Margin="28,20,28,24" HorizontalAlignment="Stretch">
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="22" Effect="{StaticResource CardShadow}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Sound Activity &amp; Diagnostics" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="Review stream runtime, delay offsets, and timestamped event logs." FontSize="12" Foreground="{StaticResource TextSlate500}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBox x:Name="EventFilterComboBox" Width="140" Height="36" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="EventFilterComboBox_SelectionChanged">
                                        <ComboBoxItem Content="All Events"/>
                                        <ComboBoxItem Content="Sync Events"/>
                                        <ComboBoxItem Content="Volume"/>
                                        <ComboBoxItem Content="Connections"/>
                                    </ComboBox>
                                    <Button x:Name="BtnClear" Content="🗑 Clear Logs" Style="{StaticResource PillButtonStyle}" Click="BtnClear_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Telemetry Grid Cards (Uniformly distributed across 100% width) -->
                        <UniformGrid Columns="4" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,6,0" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <TextBlock Text="SYNC MODE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSlate400}"/>
                                    <TextBlock Text="Manual Timing" FontSize="16" FontWeight="ExtraBold" Foreground="#047857" Margin="0,2,0,0"/>
                                    <TextBlock Text="Circular Delay Buffer" FontSize="11" Foreground="{StaticResource TextSlate500}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="3,0,3,0" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <TextBlock Text="ACTIVE STREAM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSlate400}"/>
                                    <TextBlock x:Name="StreamDurationText" Text="00:00:00" FontSize="16" FontWeight="ExtraBold" Foreground="{StaticResource TextDark}" Margin="0,2,0,0"/>
                                    <TextBlock Text="Broadcast session runtime" FontSize="11" Foreground="{StaticResource TextSlate500}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="3,0,3,0" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <TextBlock Text="RF TELEMETRY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSlate400}"/>
                                    <TextBlock Text="Unavailable" FontSize="16" FontWeight="ExtraBold" Foreground="#64748B" Margin="0,2,0,0"/>
                                    <TextBlock Text="No OS API for BT RSSI" FontSize="11" Foreground="{StaticResource TextSlate500}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="6,0,0,0" Effect="{StaticResource CardShadow}">
                                <StackPanel>
                                    <TextBlock Text="TIMING OFFSET" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSlate400}"/>
                                    <TextBlock x:Name="MetricDelayDisplay" Text="0.00 ms" FontSize="16" FontWeight="ExtraBold" Foreground="#D97706" Margin="0,2,0,0"/>
                                    <TextBlock Text="Configured Phase Delay" FontSize="11" Foreground="#047857" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Audio Waveform Monitor & Echo Test (Stretches to 100% width) -->
                        <Border Background="#0B132B" CornerRadius="16" Padding="18" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                    <TextBlock Text="Live Stream Waveform &amp; Phase Monitor" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <CheckBox x:Name="EchoTestCheckBox" Content="Audible Echo Test (+50ms)" Foreground="#CBD5E1" FontSize="11" VerticalAlignment="Center" Margin="0,0,14,0" Click="EchoTestCheckBox_Click" ToolTip="Injects an audible +50ms delay into Output 2 to audibly verify timing offset"/>
                                        <TextBlock Text="Zoom:" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="WaveZoomLabel" Text="100%" Foreground="#38BDF8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" Width="36"/>
                                        <Slider x:Name="WaveZoomSlider" Width="100" Minimum="50" Maximum="200" Value="100" SmallChange="5" LargeChange="25" Style="{StaticResource ThinVolumeSliderStyle}" ValueChanged="WaveZoomSlider_ValueChanged"/>
                                    </StackPanel>
                                </Grid>

                                <Viewbox Height="80" Stretch="Fill" Margin="0,6" HorizontalAlignment="Stretch">
                                    <Canvas x:Name="WaveCanvas" Width="1000" Height="80" ClipToBounds="True">
                                        <!-- Oscilloscope grid lines -->
                                        <Line X1="0" Y1="40" X2="1000" Y2="40" Stroke="#1E293B" StrokeThickness="1" StrokeDashArray="4 4"/>
                                        <Line X1="0" Y1="20" X2="1000" Y2="20" Stroke="#131F37" StrokeThickness="0.75" StrokeDashArray="2 4"/>
                                        <Line X1="0" Y1="60" X2="1000" Y2="60" Stroke="#131F37" StrokeThickness="0.75" StrokeDashArray="2 4"/>
                                        
                                        <Path x:Name="Wave1Path" Stroke="#38BDF8" StrokeThickness="2.5"/>
                                        <Path x:Name="Wave2Path" Stroke="#C084FC" StrokeThickness="2"/>
                                    </Canvas>
                                </Viewbox>

                                <Grid Margin="0,4,0,0" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#38BDF8" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Alpha (Node 1)" FontSize="11" Foreground="#94A3B8" Margin="0,0,12,0"/>
                                        <Ellipse Width="8" Height="8" Fill="#C084FC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Beta (Node 2)" FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                    <TextBlock x:Name="PhaseBadgeText" Text="Manual Timing: 0.00ms Offset" FontSize="11" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="JitterText" Text="Hardware Jitter: Unavailable (WASAPI Shared)" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="16" Effect="{StaticResource CardShadow}" HorizontalAlignment="Stretch">
                            <TextBox x:Name="SessionLogBox" Height="180" Background="#0F172A" Foreground="#38BDF8"
                                     FontFamily="Consolas" FontSize="11" Padding="10" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" BorderThickness="0" HorizontalAlignment="Stretch"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- PAGE 4: EXPORT / REPORT SUMMARY -->
                <ScrollViewer x:Name="Page4_ExportSummary" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
                    <StackPanel Margin="28,20,28,24" HorizontalAlignment="Stretch">
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="22" Effect="{StaticResource CardShadow}" Margin="0,0,0,16" HorizontalAlignment="Stretch">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="System Condition &amp; Telemetry Summary" FontSize="22" FontWeight="ExtraBold" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="Diagnostic report consolidating active streaming state, device endpoints, and timing offset configuration." 
                                               FontSize="12" Foreground="{StaticResource TextSlate500}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnPrintReport" Content="🖨 Print / Save Report" Style="{StaticResource PrimaryPillButtonStyle}" Click="BtnPrintReport_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="16" Padding="20" Effect="{StaticResource CardShadow}" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Stretch">
                                <Grid Margin="0,0,0,12" HorizontalAlignment="Stretch">
                                    <TextBlock Text="Consolidated Telemetry Table" FontSize="15" FontWeight="ExtraBold" Foreground="{StaticResource TextDark}"/>
                                    <TextBlock Text="Real measured parameters &amp; honest OS state" FontSize="11" Foreground="{StaticResource TextSlate400}" HorizontalAlignment="Right"/>
                                </Grid>

                                <DataGrid x:Name="ConsolidatedTelemetryGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="Transparent"
                                          BorderThickness="0" RowBackground="#FAFAFA" AlternatingRowBackground="White"
                                          HorizontalGridLinesBrush="#F1F5F9" FontSize="11" MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalAlignment="Stretch">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="100"/>
                                        <DataGridTextColumn Header="System Source" Binding="{Binding Source}" Width="160"/>
                                        <DataGridTextColumn Header="Metric / Parameter" Binding="{Binding Metric}" Width="160"/>
                                        <DataGridTextColumn Header="Value Readout" Binding="{Binding Value}" Width="200"/>
                                        <DataGridTextColumn Header="Quality State" Binding="{Binding State}" Width="110"/>
                                        <DataGridTextColumn Header="Audit Notes" Binding="{Binding Notes}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

            </Grid>

            <!-- Bottom Pinned Footer (Stretches to 100% full width) -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,0" HorizontalAlignment="Stretch">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <TextBlock Text="© 2026 DualSync • Dual Earbud Audio Sync Suite" FontSize="11" Foreground="#64748B" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="FooterStatusText" Text="● Ready • v1.0.0" FontSize="11" FontWeight="SemiBold" Foreground="#047857" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>